    "homepage": "https://github.com/marcocelia/easyjs#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/marcocelia/easyjs.git"
    },
    "bugs": {
        "url": "https://github.com/marcocelia/easyjs/issues"
    },
    "devDependencies": {
        "terser": "^5.36.0"
    }
