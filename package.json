{
    "name": "easyjs-utils",
    "version": "1.0.0",
    "description": "Libreria leggera di utility JavaScript per manipolazione DOM, eventi e classi CSS.",
    "main": "dist/easy.min.js",
    "module": "src/easy.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npx terser src/easy.js -o dist/easy.min.js --compress --mangle",
